# FOFA API Key。
FOFA_API_KEY=

# 默认使用 FOFA 官方 API；代码负责追加 /api/v1/... 路径。
FOFA_API_BASE_URL=https://fofa.info

# 仅使用支持 /api/auth/login 与 /api/auth/userinfo 的中转平台时设为 true。
FOFA_RELAY_QUOTA_ENABLED=false

# Web 监听地址；默认只监听本机。
WEB_BIND_ADDRESS=127.0.0.1:3000

# SQLite 数据库目录；应用会自动创建 cyberscope.db。
DATABASE_PATH=data
